# Local Stash `plugins` directory — used by deploy.mjs
# The built plugin will be copied to: <STASH_PLUGINS_DIR>/<project-name>/
STASH_PLUGINS_DIR=""

# Stash plugin source index repository directory — used by release.mjs
# The built plugin will be copied to: <STASH_SOURCE_INDEX_DIR>/<project-name>/
# Example: STASH_SOURCE_INDEX_DIR="D:/stash-source-index-repo/plugins"
STASH_SOURCE_INDEX_DIR=""